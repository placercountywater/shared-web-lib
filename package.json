{
  "private": true,
  "scripts": {
    "preinstall": "npx --yes --loglevel=error only-allow npm",
    "format": "prettier --config .prettierrc --write './**/*.{ts,tsx,css}'",
    "type-check": "tsc --noEmit -p .",
    "type-check:watch": "npm run type-check -- --watch",
    "clean": "npx --yes rimraf node_modules tsconfig.tsbuildinfo",
    "reinstall": "npm run clean && npm install",
    "deps:check": "npm outdated || true",
    "deps:upgrade": "npx --yes npm-check-updates --interactive --format group --target minor",
    "deps:upgrade:major": "npx --yes npm-check-updates --interactive --format group --target latest"
  },
  "devDependencies": {
    "@mui/icons-material": "^9.2.0",
    "@mui/material": "^9.2.0",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "next": "^16.2.12",
    "prettier": "^3.9.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1101.0",
    "@date-fns/tz": "^1.5.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "filenamify": "^7.0.2",
    "slate": "^0.126.0",
    "slate-dom": "^0.126.0",
    "slate-history": "^0.113.1",
    "slate-react": "^0.126.0",
    "tailwind-merge": "^3.6.0",
    "use-debounce": "^10.1.1",
    "usehooks-ts": "^3.1.1",
    "xss": "^1.0.15"
  },
  "peerDependencies": {
    "@mui/icons-material": "^9",
    "@mui/material": "^9",
    "next": "^16",
    "react": "^19",
    "react-dom": "^19"
  }
}
