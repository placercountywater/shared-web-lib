# Node.js dependencies
node_modules/

# this project standardizes on npm; no other package manager's files belong here
.pnp.*
.yarn/

# Deliberately untracked, whichever package manager wrote it. This repo is
# consumed as a git submodule of source files -- nothing installs it, so a
# committed lockfile pins nothing a consumer ever resolves. node_modules here
# exists only for `npm run type-check` and editor IntelliSense. Committing one
# only fed GitHub a manifest to raise advisories against for versions no app
# ever ships.
package-lock.json
yarn.lock
pnpm-lock.yaml
bun.lock
bun.lockb

# TypeScript cache/output
dist/
build/
out/
*.tsbuildinfo

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Diagnostic reports
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json
pmdoc.json

# Runtime data
pids/
*.pid
*.seed
*.pid.lock

# Directory for instrumented libs generated by jscoverage/JSCover
lib-cov/

# Coverage directory used by tools like istanbul
coverage/

# nyc test coverage
.nyc_output/

# Grunt intermediate storage (https://gruntjs.com/creating-plugins#storing-task-files)
.grunt/

# Dependency directories
jspm_packages/

# dotenv environment variable files
.env
.env.test
.env.production
.env.development.local
.env.test.local
.env.production.local

# IDE specific folders
.idea/
.vscode/
*.sublime-workspace
*.sublime-project

# MacOS specific files
.DS_Store

# TypeScript compiled output
*.d.ts.map
*.js.map
*.jsx.map
*.ts.map
*.tsx.map


# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Optional stylelint cache
.stylelintcache

# Husky configuration
.husky/_/

# Lint-staged configuration
.lintstagedrc.json

# Binaries for modules
*.node

# Optional jest cache directory
jest.config.js
jest/
